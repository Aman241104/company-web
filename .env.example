# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave unset to disable — no tracking script loads without it.
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook/Instagram) Pixel ID, for ad conversion tracking & retargeting.
# Leave unset to disable — no pixel loads without it.
NEXT_PUBLIC_META_PIXEL_ID=

# Resend API key (https://resend.com) — powers /api/contact so lead forms deliver
# even for visitors without a configured desktop email client. Without this set,
# forms fall back to opening the visitor's mailto: client instead.
RESEND_API_KEY=

# Inbox that receives contact-form submissions. Defaults to hello@mehtatechnologies.com.
CONTACT_TO_EMAIL=

# Verified Resend sender identity, e.g. "Mehta Technologies <hello@mehtatechnologies.com>".
# Must be a domain verified in your Resend account, or sends will fail.
CONTACT_FROM_EMAIL=
